# Target cluster configuration
export CLUSTER_NAME=target-cluster
export KUBERNETES_VERSION=v1.31.4+k3s1
export CONTROL_PLANE_MACHINE_COUNT=1
export WORKER_MACHINE_COUNT=1

# VM resource configuration
export VM_CPU_CORES=2
export VM_MEMORY=4Gi
export VM_DISK_SIZE=10Gi

# Source DataVolume for cloning
export SOURCE_DV_NAME=ubuntu-noble-dv
export SOURCE_DV_NAMESPACE=default
